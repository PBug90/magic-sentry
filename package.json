{
  "name": "magic-sentry-monorepo",
  "private": true,
  "workspaces": [
    "wc3data",
    "shared",
    "viewer",
    "twitch-extension",
    "web"
  ],
  "scripts": {
    "build:wc3data": "tsc -p wc3data/tsconfig.json",
    "build:shared": "tsc -p wc3data/tsconfig.json && tsc -p shared/tsconfig.json",
    "build:icons": "tsx scripts/build-standalone.ts",
    "build:standalone": "npm run build:icons && npm -w magic-sentry-web run build:standalone",
    "dev": "docker compose up -d && concurrently --names \"web,ext\" --prefix-colors \"cyan,magenta\" \"npm -w magic-sentry-web run dev\" \"npm -w twitch-extension run dev\"",
    "dev:extension": "npm -w twitch-extension run dev",
    "dev:web": "npm -w magic-sentry-web run dev",
    "build:extension": "npm -w twitch-extension run build",
    "build:web": "npm -w magic-sentry-web run build",
    "build:all": "npm -w twitch-extension run build && npm -w magic-sentry-web run build",
    "typecheck:extension": "npm -w twitch-extension run typecheck",
    "typecheck:viewer": "npm -w @magic-sentry/viewer run typecheck",
    "typecheck:web": "npm -w magic-sentry-web run typecheck",
    "test:shared": "npm -w @magic-sentry/shared run test",
    "test:web": "npm -w magic-sentry-web run test:server",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\""
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "sharp": "^0.35.2"
  }
}
