{
  "name": "magic-sentry-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx --watch --env-file=.env src/server/index.ts",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --env-file=.env dist/server/index.js",
    "typecheck": "npm run build:shared && tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build:shared": "tsc -p ../shared/tsconfig.json",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "test:server": "vitest run --config vitest.config.server.ts"
  },
  "dependencies": {
    "@magic-sentry/shared": "*",
    "hono": "^4.6.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
