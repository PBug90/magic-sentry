PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/magic_sentry
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
VITE_EXTENSION_URL=

# Patreon — optional. If PATREON_CLIENT_ID is unset the feature is inert.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=http://localhost:3000/auth/patreon/callback
# Comma-separated Patreon tier ids that grant access.
PATREON_ACCESS_TIER_IDS=
# Periodic member sync (campaign-members model). Leave unset to disable re-sync.
PATREON_CAMPAIGN_ID=
PATREON_CREATOR_ACCESS_TOKEN=
PATREON_CREATOR_REFRESH_TOKEN=
# Optional: re-sync interval in ms (default 6h).
PATREON_SYNC_INTERVAL_MS=
