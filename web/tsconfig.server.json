{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {},
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src/server",
    "outDir": "dist/server",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "jsx": "react-jsx"
  },
  "include": ["src/server"]
}
